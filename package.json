{
  "name": "schoolledger-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SchoolLedger — headless school information system (SIS) backend: modular monolith, event-driven workers, OpenAPI 3.1 contract.",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "cookie": "^1.0.2"
  },
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "seed": "tsx prisma/seed.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.19.3",
    "@sinclair/typebox": "^0.34.52",
    "bullmq": "^6.3.15",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "embedded-postgres": "18.4.0-beta.17",
    "pino-pretty": "^13.2.0",
    "prisma": "6.19.3",
    "redis-memory-server": "^0.17.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
