# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
WORKERS_ENABLED=true
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://portal:portal@localhost:5432/portal?schema=public

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# When false the process degrades gracefully (DB-only capacity path) if Redis is unreachable.
REDIS_REQUIRED=true

# ─── Secrets (CHANGE ALL OF THESE IN PRODUCTION) ──────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_MFA_SECRET=dev-mfa-secret-change-me-0123456789abcdef
DOCUMENT_HMAC_SECRET=dev-document-hmac-secret-change-me-0123456789
# Key used to sign local (filesystem) presigned URLs when STORAGE_DRIVER=fs
PRESIGN_SECRET=dev-presign-secret-change-me-0123456789abcdef

# ─── Token policy ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
MFA_TOKEN_TTL_MINUTES=5
STEP_UP_TTL_MINUTES=5

# ─── Academic policy (see RECONSTRUCTION_LEDGER.md §4) ────────────────────────
PASSING_GRADE_MAX=3.00
INC_COMPLETION_DAYS=365
INC_DEFAULT_GRADE=5.00
DEANS_LISTER_MAX_GWA=1.45
HONORS_SUMMA_MAX=1.20
HONORS_MAGNA_MAX=1.45
HONORS_CUMLAUDE_MAX=1.75
MAX_ACADEMIC_UNITS=30

# ─── Document storage ─────────────────────────────────────────────────────────
# fs = local filesystem (dev/test) | s3 = S3-compatible (MinIO/AWS)
STORAGE_DRIVER=fs
STORAGE_FS_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=portal-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
PRESIGN_TTL_SECONDS=300

# ─── Fees ─────────────────────────────────────────────────────────────────────
CURRENCY=PHP

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
